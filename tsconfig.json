{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "types": ["bun", "node"],
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "tsdown.config.ts"]
}
